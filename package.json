{
  "name": "britago",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "vercel-build": "eslint . --max-warnings=0 && prettier --check . && next build"
  },
  "dependencies": {
    "@tanstack/react-query": "~5.101.4",
    "@vercel/analytics": "~2.0.1",
    "@vercel/speed-insights": "~2.0.0",
    "axios": "~1.18.1",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "framer-motion": "~12.40.0",
    "next": "16.2.12",
    "radix-ui": "~1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "~5.6.0",
    "resend": "~6.18.0",
    "tailwind-merge": "~3.6.0",
    "tw-animate-css": "~1.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "~4.3.1",
    "@types/node": "~20.19.43",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "eslint": "~9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "~10.1.8",
    "lint-staged": "~17.0.8",
    "prettier": "~3.9.0",
    "prettier-plugin-tailwindcss": "~0.8.0",
    "shadcn": "~4.15.0",
    "tailwindcss": "~4.3.1",
    "typescript": "~5.9.3"
  }
}
